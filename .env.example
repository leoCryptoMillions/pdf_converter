# PDF Converter 0.7.0: variables que consume el MVP de un usuario.
# Plantilla informativa: la app NO carga .env automáticamente.
# Exporta las variables en tu consola o en la configuración del proceso.
APP_MODE=local
HOST=127.0.0.1
PORT=8420
# En remote, configurar AMBAS credenciales fuera del repositorio y usar HTTPS.
# AUTH_USERNAME=
# AUTH_PASSWORD=
CONVERT_CONCURRENCY=1
WEB_CONCURRENCY=1
UVICORN_WORKERS=1
CONVERT_TIMEOUT_SECONDS=90
CONVERT_GRACE_SECONDS=5
CONVERT_MEMORY_LIMIT_MB=768
RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=3600
MAX_STORAGE_MB=2048
MAX_JOB_MB=512
MIN_FREE_DISK_MB=256
# Límites fijos: un PDF, 25 MiB, 100 páginas; no hay cuotas por usuario.
