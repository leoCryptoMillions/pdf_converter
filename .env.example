# ============================================================================
# PDF Converter Application - Environment Configuration
# ============================================================================
# Version: 1.0.0 (Based on PLAN_APP_CONVERSION_PDF_v1.0.md)
# Purpose: Define all environment variables for different deployment environments
#
# IMPORTANT:
# - Copy this file to .env and fill in actual values for your environment
# - NEVER commit .env with secrets, API keys, or database passwords to version control
# - NEVER store production credentials, tokens, or sensitive data in this file
# - Use a secure secret management system (e.g., HashiCorp Vault, AWS Secrets Manager)
# ============================================================================

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================

# Deployment environment (development|staging|production)
# - development: Local development with debug enabled
# - staging: Pre-production environment for testing
# - production: Live production environment
ENVIRONMENT=development

# Application name and version
APP_NAME=PDF Converter
APP_VERSION=1.0.0

# Enable debug mode (ONLY in development)
# Set to False in staging/production for security
DEBUG=True

# Application secret key for session signing and CSRF protection
# MUST be changed in production! Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-with-secure-random-key

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: DEBUG|INFO|WARNING|ERROR|CRITICAL
LOG_LEVEL=INFO

# Log format: json (structured) or text (human-readable)
LOG_FORMAT=json

# Log file path (absolute or relative)
LOG_FILE=/tmp/pdf-converter.log

# Maximum log file size in MB before rotation
LOG_FILE_SIZE_MB=100

# Number of backup log files to keep
LOG_BACKUP_COUNT=10

# Output logs to console
LOG_TO_CONSOLE=True

# Output logs to file
LOG_TO_FILE=True

# Never log sensitive data (secrets, tokens, passwords)
SECRETS_IN_LOGS=False

# Mask personally identifiable information in logs
PII_MASKING=True

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================

# FastAPI server host binding
API_HOST=0.0.0.0

# FastAPI server port
API_PORT=8000

# Number of API worker processes
API_WORKERS=4

# Auto-reload on code changes (development only)
API_RELOAD=True

# API documentation title
API_TITLE=PDF Converter API

# API documentation description
API_DESCRIPTION=Convert PDFs to Excel, Word, CSV, TXT, Markdown, JSON and PNG/JPEG formats

# API version for documentation
API_VERSION=v1

# ============================================================================
# CORS (Cross-Origin Resource Sharing) CONFIGURATION
# ============================================================================

# Allowed origins for CORS (JSON array format or comma-separated)
# Examples: ["http://localhost:3000","http://localhost:8000"] or http://localhost:3000,http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Allow credentials (cookies, authorization headers) in CORS requests
CORS_ALLOW_CREDENTIALS=True

# Allowed HTTP methods for CORS
CORS_ALLOW_METHODS=["*"]

# Allowed HTTP headers for CORS
CORS_ALLOW_HEADERS=["*"]

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================

# PostgreSQL connection URL
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/pdf_converter
DATABASE_URL=postgresql://postgres:password@localhost:5432/pdf_converter

# Connection pool size (number of connections to keep open)
# Set based on expected concurrent users and workers
DATABASE_POOL_SIZE=20

# Maximum overflow connections above pool_size
DATABASE_MAX_OVERFLOW=40

# Connection timeout in seconds
DATABASE_POOL_TIMEOUT=30

# Recycle connections after N seconds (helps with connection issues)
DATABASE_POOL_RECYCLE=3600

# Echo SQL statements to logs (debug only, set to False in production)
DATABASE_ECHO=False

# Enable automatic migrations on startup (use with caution in production)
DATABASE_AUTO_MIGRATE=False

# ============================================================================
# REDIS CONFIGURATION (Caching and Session Storage)
# ============================================================================

# Redis connection URL
# Format: redis://[:password]@host:port/db_number
REDIS_URL=redis://localhost:6379/0

# Redis socket timeout in seconds
REDIS_SOCKET_TIMEOUT=5

# Redis socket connection timeout in seconds
REDIS_SOCKET_CONNECT_TIMEOUT=5

# ============================================================================
# MESSAGE QUEUE CONFIGURATION (RabbitMQ & Celery)
# ============================================================================

# RabbitMQ connection parameters
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# Celery broker URL (RabbitMQ connection string)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# Celery result backend (Redis for storing task results)
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Celery serialization format
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# Celery timezone
CELERY_TIMEZONE=UTC

# Track task progress
CELERY_TASK_TRACK_STARTED=True

# Task time limit in seconds (plan specifies 10 minutes = 600 seconds)
# This is a hard limit - task is killed if it exceeds this time
CELERY_TASK_TIME_LIMIT=600

# Task soft time limit in seconds (90 seconds before hard limit)
# Task receives SIGTERM and can clean up gracefully
CELERY_TASK_SOFT_TIME_LIMIT=540

# Prefetch multiplier: number of tasks worker will reserve from broker
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Maximum number of tasks a worker will process before recycling
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# Queue names for different task types
QUEUE_CONVERSION_TASKS=pdf_conversion_tasks
QUEUE_EXPORT_TASKS=pdf_export_tasks
QUEUE_CLEANUP_TASKS=pdf_cleanup_tasks

# ============================================================================
# FILE STORAGE CONFIGURATION
# ============================================================================

# Storage backend type: local|s3|s3_compatible
STORAGE_TYPE=local

# Local storage path (when STORAGE_TYPE=local)
STORAGE_LOCAL_PATH=/tmp/pdf-converter-storage

# Quarantine directory for uploaded files (before validation)
QUARANTINE_PATH=/tmp/pdf-converter-quarantine

# ============================================================================
# S3 STORAGE CONFIGURATION (Alternative to Local Storage)
# ============================================================================
# Uncomment and configure if using S3 or S3-compatible storage (e.g., MinIO)

# STORAGE_TYPE=s3
# S3_BUCKET=pdf-converter-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your_access_key_id
# S3_SECRET_ACCESS_KEY=your_secret_access_key
# S3_ENDPOINT_URL=http://localhost:9000  # For MinIO local development
# S3_USE_SSL=False  # Set to True for production
# S3_SIGNATURE_VERSION=s3v4

# ============================================================================
# FILE SIZE AND UPLOAD LIMITS
# ============================================================================

# Maximum file size in MB (plan specifies 25 MB)
# This is the hard limit for individual PDF uploads
MAX_FILE_SIZE_MB=25

# Maximum number of pages per job (plan specifies 100)
# Single page processing or multi-page jobs must not exceed this limit
MAX_PAGES_PER_JOB=100

# Maximum batch size: number of files in a single batch (plan specifies 10)
MAX_BATCH_SIZE=10

# Maximum jobs per user per hour (rate limiting)
MAX_JOBS_PER_USER_PER_HOUR=50

# Maximum concurrent jobs allowed in the system
MAX_CONCURRENT_JOBS=10

# Maximum upload chunk size in MB (for streaming uploads)
MAX_UPLOAD_CHUNK_SIZE_MB=5

# Allowed file upload extensions (comma-separated)
ALLOWED_UPLOAD_EXTENSIONS=pdf

# Validate content-type of uploaded files
CONTENT_TYPE_VALIDATION=True

# ============================================================================
# CONVERSION PROCESSING CONFIGURATION
# ============================================================================

# Maximum processing time per job in seconds (plan specifies 10 minutes = 600 seconds)
MAX_PROCESSING_TIME_SECONDS=600

# Maximum memory per conversion process in MB
MAX_MEMORY_PER_PROCESS_MB=2048

# CPU cores limit per job (0 = no limit, use cautiously)
MAX_CPU_CORES_PER_JOB=2

# Enable GPU acceleration (if available)
ENABLE_GPU=False

# Temporary directory for processing files
TEMP_DIR=/tmp/pdf-converter-temp

# Model cache directory (for OCR and ML models)
MODEL_CACHE_DIR=/tmp/pdf-converter-models

# Preload models on startup (speeds up first request, uses more memory)
PRELOAD_MODELS=False

# ============================================================================
# OUTPUT FORMATS CONFIGURATION
# ============================================================================

# Supported output formats (comma-separated)
# Plan supports: xlsx, docx, csv, txt, markdown, json, png, jpeg
SUPPORTED_OUTPUT_FORMATS=xlsx,docx,csv,txt,markdown,json,png,jpeg

# Default image DPI for PNG/JPEG export
IMAGE_DPI=150

# Maximum image width in pixels (prevents memory exhaustion)
MAX_IMAGE_WIDTH=3000

# Maximum image height in pixels
MAX_IMAGE_HEIGHT=3000

# Maximum total pixels per image (3000x3000 = 9,000,000)
MAX_IMAGE_PIXELS=9000000

# ============================================================================
# OCR (OPTICAL CHARACTER RECOGNITION) CONFIGURATION
# ============================================================================

# OCR engine: tesseract|paddleocr|docling
# Plan recommends starting with Tesseract for Spanish/English
OCR_ENGINE=tesseract

# OCR languages (comma-separated language codes)
# Plan specifies Spanish (spa) and English (eng)
OCR_LANGUAGES=spa,eng

# Path to Tesseract executable
TESSERACT_PATH=/usr/bin/tesseract

# OCR timeout in seconds (must be less than MAX_PROCESSING_TIME_SECONDS)
OCR_TIMEOUT_SECONDS=300

# OCR confidence threshold (0.0 to 1.0)
# Higher values = only high-confidence words included
OCR_CONFIDENCE_THRESHOLD=0.7

# Enable OCR preprocessing (rotation detection, deskewing)
OCR_PREPROCESSING_ENABLED=True

# ============================================================================
# PDF PARSING ENGINES
# ============================================================================

# Primary PDF parser engine: pdfplumber|docling|camelot
# Plan recommends pdfplumber as initial lightweight engine
PDF_PARSER_ENGINE=pdfplumber

# Enable Docling for advanced structured extraction
ENABLE_DOCLING=True

# Enable Camelot for alternative table extraction
ENABLE_CAMELOT=False

# Enable PDF.js for web preview (always used for frontend preview)
PDF_JS_ENABLED=True

# PyPDFium2 for page rendering
ENABLE_PYPDFIUM2=True

# ============================================================================
# CONTENT RETENTION AND CLEANUP POLICY
# ============================================================================

# Content retention period in hours (plan specifies 24 hours)
# After this period, files and results are automatically deleted
RETENTION_HOURS=24

# Enable automatic deletion of expired content
AUTO_DELETE_ENABLED=True

# Cron schedule for cleanup task (runs every 6 hours)
# Format: minute hour day_of_month month day_of_week
# Example: 0 */6 * * * (every 6 hours)
AUTO_DELETE_CRON_SCHEDULE=0 */6 * * *

# Enable early deletion (users can request immediate deletion)
EARLY_DELETION_ENABLED=True

# Archive old conversions instead of deleting (optional)
ARCHIVE_INSTEAD_OF_DELETE=False

# Archive location path (if archiving enabled)
ARCHIVE_PATH=/tmp/pdf-converter-archive

# ============================================================================
# AUTHENTICATION AND AUTHORIZATION
# ============================================================================

# JWT algorithm for token signing
ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=30

# ============================================================================
# SESSION AND COOKIE SECURITY
# ============================================================================

# Session cookie secure flag (set to True in production with HTTPS)
SESSION_COOKIE_SECURE=False

# Session cookie HTTP-only (prevents JavaScript access)
SESSION_COOKIE_HTTPONLY=True

# Session cookie SameSite policy: Strict|Lax|None
SESSION_COOKIE_SAMESITE=Lax

# ============================================================================
# CSRF PROTECTION
# ============================================================================

# Enable CSRF protection
CSRF_ENABLED=True

# Trusted origins for CSRF (JSON array or comma-separated)
CSRF_TRUSTED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ============================================================================
# PDF-SPECIFIC SECURITY SETTINGS
# ============================================================================

# Enable password-protected PDF handling
PDF_PASSWORD_HANDLING_ENABLED=True

# Timeout for password attempts in seconds
PDF_PASSWORD_TIMEOUT=30

# Maximum password attempts before blocking
PDF_PASSWORD_MAX_ATTEMPTS=5

# Enable encrypted PDF support
PDF_ENCRYPTION_HANDLING_ENABLED=True

# Enable PDF signature detection (does not verify signatures)
PDF_SIGNATURE_DETECTION_ENABLED=True

# Timeout for detecting encrypted PDFs
PDF_DETECTION_TIMEOUT=10

# ============================================================================
# GENERAL SECURITY HEADERS
# ============================================================================

# Content Security Policy header enabled
SECURITY_CSP_ENABLED=True

# X-Frame-Options header (clickjacking protection): DENY|SAMEORIGIN|ALLOW-FROM
SECURITY_FRAME_OPTIONS_ENABLED=True

# X-Content-Type-Options header (prevents MIME sniffing)
SECURITY_CONTENT_TYPE_OPTIONS_ENABLED=True

# ============================================================================
# FILE UPLOAD AND VALIDATION SECURITY
# ============================================================================

# Virus scanning enabled (requires antivirus integration)
VIRUS_SCAN_ENABLED=False

# Validate file magic bytes (not just extension)
VALIDATE_FILE_MAGIC_BYTES=True

# ============================================================================
# MONITORING AND OBSERVABILITY
# ============================================================================

# Enable metrics collection (Prometheus)
METRICS_ENABLED=True

# Prometheus metrics port
METRICS_PORT=9090

# Sentry error tracking (leave empty to disable)
SENTRY_DSN=

# Sentry environment
SENTRY_ENVIRONMENT=development

# Sentry traces sample rate (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Enable request tracing
TRACING_ENABLED=True

# Tracing backend: jaeger|datadog|none
TRACING_BACKEND=jaeger

# Jaeger agent host
JAEGER_HOST=localhost

# Jaeger agent port
JAEGER_PORT=6831

# ============================================================================
# AUTHENTICATION PROVIDER
# ============================================================================

# Authentication provider type: local|oidc|oauth2
AUTH_PROVIDER=local

# Multi-factor authentication enabled
MFA_ENABLED=False

# ============================================================================
# OIDC (OpenID Connect) CONFIGURATION
# ============================================================================
# Uncomment and configure if using OIDC for authentication

# OIDC provider URL
# OIDC_PROVIDER_URL=https://your-oidc-provider.com

# OIDC client ID
# OIDC_CLIENT_ID=your_client_id

# OIDC client secret
# OIDC_CLIENT_SECRET=your_client_secret

# OIDC redirect URL
# OIDC_REDIRECT_URL=http://localhost:8000/auth/callback

# OIDC scopes
# OIDC_SCOPES=openid,profile,email

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Enable email notifications
EMAIL_ENABLED=False

# SMTP server host
SMTP_HOST=localhost

# SMTP server port
SMTP_PORT=1025

# SMTP username (leave empty if no auth required)
SMTP_USERNAME=

# SMTP password (leave empty if no auth required)
SMTP_PASSWORD=

# Email sender address
SMTP_FROM_EMAIL=noreply@pdf-converter.local

# Email sender name
SMTP_FROM_NAME=PDF Converter

# Enable TLS for SMTP
SMTP_TLS_ENABLED=True

# Send email notification when conversion completes
SEND_EMAIL_ON_COMPLETION=False

# Retry email sending N times on failure
EMAIL_MAX_RETRIES=3

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================

# Cache backend: memory|redis|disabled
CACHE_BACKEND=memory

# Cache TTL for conversion results in seconds (1 hour = 3600)
CACHE_RESULT_TTL=3600

# Cache TTL for model data in seconds (1 day = 86400)
CACHE_MODEL_TTL=86400

# Enable metadata caching
CACHE_METADATA_ENABLED=True

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable OCR processing
FEATURE_OCR_ENABLED=True

# Enable batch processing (multiple files in one request)
FEATURE_BATCH_PROCESSING=False

# Enable table correction/editing interface
FEATURE_TABLE_CORRECTION=True

# Enable advanced text formatting in Word export
FEATURE_ADVANCED_FORMATTING=False

# Enable PowerPoint (PPTX) export (not in MVP)
FEATURE_PPTX_EXPORT=False

# Enable dark mode in UI
FEATURE_DARK_MODE=True

# Enable mobile-optimized interface
FEATURE_MOBILE_UI=True

# ============================================================================
# WORKER PROCESS CONFIGURATION
# ============================================================================

# Number of worker processes
WORKER_CONCURRENCY=4

# Worker prefetch count
WORKER_PREFETCH_MULTIPLIER=1

# Maximum tasks per worker before recycling
WORKER_MAX_TASKS_PER_CHILD=1000

# Worker timeout in seconds (should be >= MAX_PROCESSING_TIME_SECONDS)
WORKER_TIMEOUT=660

# ============================================================================
# DEVELOPMENT AND TESTING CONFIGURATION
# ============================================================================
# WARNING: Use only in development/testing environments - NEVER in production

# Seed database with test data on startup
SEED_DATABASE=False

# Create sample PDF files for testing
CREATE_SAMPLE_DATA=False

# Skip database migrations on startup
SKIP_MIGRATIONS=False

# Disable authentication for testing
DISABLE_AUTH_FOR_TESTING=False

# Fake processing delay for UI testing (milliseconds)
FAKE_PROCESSING_DELAY_MS=0

# Mock external services (use dummy responses)
MOCK_EXTERNAL_SERVICES=False

# Enable verbose processing logs
VERBOSE_PROCESSING_LOGS=False
